<!-- Floating Chatbot -->
<button id="chatbot-toggle" type="button" aria-label="Abrir chat">💬</button>

<div id="chatbot" class="chatbot-hidden" aria-live="polite">
	<div class="chatbot-header">
		<div class="chatbot-title">
			<strong>Asistente</strong>
			<small>¿En qué te ayudo?</small>
		</div>
		<button id="chatbot-close" type="button" aria-label="Cerrar chat">✕</button>
	</div>

	<div id="chatbot-messages" class="chatbot-messages"></div>

	<div class="chatbot-input">
		<input id="chatbot-text" type="text" placeholder="Escribí tu mensaje..." autocomplete="off" />
		<button id="chatbot-send" type="button">Enviar</button>
	</div>
</div>